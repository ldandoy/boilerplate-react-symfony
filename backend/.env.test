# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Base de test : le suffixe "_test" est ajouté automatiquement par doctrine.yaml (=> app_test)
DATABASE_URL="mysql://root:@db:3306/app?serverVersion=8.0.32&charset=utf8mb4"

# Clés JWT dédiées aux tests (générées par : bin/console lexik:jwt:generate-keypair --env=test)
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/test/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/test/public.pem
JWT_PASSPHRASE=test
