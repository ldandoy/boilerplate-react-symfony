{% extends 'base.html.twig' %}

{% block title %}Ajouter un article{% endblock %}

{% block body %}
    <div class="container">
        <h2>Ajouter un article</h2>

        {{ form_start(form) }}
            {{ form_row(form.title) }}
            {{ form_row(form.content) }}
            {{ form_row(form.publishedAt) }}
            {{ form_row(form.submit) }}
        {{ form_end(form) }}

        <p class="mt-3"><a class="btn btn-secondary" href="{{ path('app_blog') }}">Retour à la liste des articles</a></p>
    </div>

{% endblock %}