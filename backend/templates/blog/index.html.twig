{% extends 'base.html.twig' %}

{% block title %}Blog !{% endblock %}

{% block body %}
  <div class="container">
    <div class="d-flex justify-content-between align-items-center my-4">
      <h2>Articles</h2>
      <p><a class="btn btn-success" href="{{ path('blog_new') }}">Ajotuer un article</a></p>
    </div>
    <ul>
      {% for article in articles %}
        <li>
          <a href="{{ path('blog_show', {id: article.id}) }}"><strong>{{ article.title }}</strong></a> publié le {{ article.publishedAt|date('d/m/Y') }}
        </li>
      {% else %}
        <li>Aucun article</li>
      {% endfor %}
    </ul>
  </div>
{% endblock %}