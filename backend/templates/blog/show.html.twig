{% extends 'base.html.twig' %}

{% block title %}Blog !{% endblock %}

{% block body %}
  <div class="container">
    <div class="d-flex justify-content-between align-items-center my-4">
      <h2>{{ post.title }}</h2>
      <p>
        <a class="btn btn-danger" href="{{ path('blog_delete', {id: post.id}) }}" onclick="return confirm('Êtes-vous sûr de vouloir supprimer cet article ?')">Supprimer</a>
        <a class="btn btn-primary" href="{{ path('blog_edit', {id: post.id}) }}">Modifier</a>
      </p>
    </div>

    <p>{{ post.content }}</p>

    <p>Publié le {{ post.publishedAt|date('d/m/Y') }}</p>

    <p class="mt-3"><a class="btn btn-secondary" href="{{ path('app_blog') }}">Retour à la liste des articles</a></p>

  </div>
{% endblock %}